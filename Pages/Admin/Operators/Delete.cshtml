@page "{id:int}"
@model _24LockyLockers.Pages.Admin.Operators.DeleteModel
@{
    ViewData["Title"] = "Delete Operator";
}

<h2 class="mb-4">Delete Operator</h2>

<div class="alert alert-danger delete-confirmation">
    <h4>Are you sure you want to delete this operator?</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">Name</dt>
        <dd class="col-sm-9">@Model.Operator?.Name</dd>

        <dt class="col-sm-3">Email</dt>
        <dd class="col-sm-9">@Model.Operator?.Email</dd>

        <dt class="col-sm-3">Status</dt>
        <dd class="col-sm-9">
            @if (Model.Operator?.IsActive == true)
            {
                <span class="badge bg-success">Active</span>
            }
            else
            {
                <span class="badge bg-danger">Inactive</span>
            }
        </dd>

        <dt class="col-sm-3">Created At</dt>
        <dd class="col-sm-9">@Model.Operator?.CreatedAt.ToString("dd/MM/yyyy")</dd>
    </dl>

    <form method="post" class="mt-4">
        <input type="hidden" asp-for="Operator.Id" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-page="Index" class="btn btn-outline-secondary">Cancel</a>
    </form>
</div>