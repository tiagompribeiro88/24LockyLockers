@page
@model _24LockyLockers.Pages.Admin.Lockers.CreateModel
@{
    ViewData["Title"] = "Add Locker";
}

<h2 class="mb-4">Add New Locker</h2>

<div class="form-locky">
    <form method="post">
        <div asp-validation-summary="All" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="Input.LockerNumber" class="form-label">Locker Number</label>
            <input asp-for="Input.LockerNumber" class="form-control" placeholder="PT-OPO-001">
            <span asp-validation-for="Input.LockerNumber" class="text-danger"></span>
            <small class="text-muted">Format: XX-XXX-000 (e.g., PT-OPO-001)</small>
        </div>

        <div class="mb-3">
            <label asp-for="Input.LocationId" class="form-label">Location</label>
            <select asp-for="Input.LocationId" class="form-select" asp-items="Model.Locations.Select(l => new SelectListItem { Value = l.Id.ToString(), Text = l.LocationName })">
                <option value="">-- Select Location --</option>
            </select>
            <span asp-validation-for="Input.LocationId" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Input.IsAvailable" class="form-label">Status</label>
            <select asp-for="Input.IsAvailable" class="form-select">
                <option value="true">Available</option>
                <option value="false">Occupied</option>
            </select>
        </div>

        <div class="d-grid gap-2">
            <button type="submit" class="btn btn-locky-primary">Add Locker</button>
            <a asp-page="Index" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>