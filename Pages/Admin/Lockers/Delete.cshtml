@page "{id:int}"
@model _24LockyLockers.Pages.Admin.Lockers.DeleteModel
@{
    ViewData["Title"] = "Delete Locker";
}

<h2 class="mb-4">Delete Locker</h2>

<div class="alert alert-danger delete-confirmation">
    <h4>Are you sure you want to delete this locker?</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">Locker Number</dt>
        <dd class="col-sm-9">@Model.Locker?.LockerNumber</dd>

        <dt class="col-sm-3">Status</dt>
        <dd class="col-sm-9">
            @if (Model.Locker?.IsAvailable == true)
            {
                <span class="badge bg-success">Available</span>
            }
            else
            {
                <span class="badge bg-danger">Occupied</span>
            }
        </dd>

        <dt class="col-sm-3">Location</dt>
        <dd class="col-sm-9">@Model.Locker?.Location?.LocationName</dd>

        <dt class="col-sm-3">Last Used</dt>
        <dd class="col-sm-9">@(Model.Locker?.LastUsed?.ToString("dd/MM/yyyy HH:mm") ?? "-")</dd>
    </dl>

    <form method="post" class="mt-4">
        <input type="hidden" asp-for="Locker.Id" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-page="Index" class="btn btn-outline-secondary">Cancel</a>
    </form>
</div>