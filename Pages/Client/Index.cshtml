@page
@model _24LockyLockers.Pages.Client.IndexModel
@{
    ViewData["Title"] = "Client Dashboard";
}

<div class="container">
    <div class="page-header">
        <h1><i class="bi bi-person-circle"></i> Client Dashboard</h1>
        <p class="text-white-50">Browse and rent lockers across Portugal and Spain</p>
    </div>

    <div class="row mb-4">
    <div class="col-12">
        <a asp-page="/Client/MyRentals" class="btn btn-outline-light">
            <i class="bi bi-list-ul"></i> My Rentals
        </a>
    </div>

</div>
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">Available Lockers</h4>
                    <p class="card-text">Select a location to view available lockers.</p>

                    <div class="row mt-4">
                        <!-- Portugal -->
                        <div class="col-md-6 mb-4">
                            <div class="card h-100 border-primary">
                                <div class="card-header bg-primary text-white">
                                    <h5 class="mb-0">
                                        <span class="fi fi-pt" style="font-size: 1.5rem; margin-right: 8px;"></span>Portugal
                                    </h5>
                                </div>
                                <div class="card-body">
                                    <ul class="list-group list-group-flush">
                                        <li class="list-group-item d-flex justify-content-between align-items-center">
                                            <span><i class="bi bi-airplane-fill text-primary"></i> Porto Airport (OPO)</span>
                                            <a href="/Lockers?location=PT-OPO" class="btn btn-sm" style="min-width: 100px; background-color: #0d6efd; color: white; border: none;">View Lockers</a>
                                        </li>
                                        <li class="list-group-item d-flex justify-content-between align-items-center">
                                            <span><i class="bi bi-airplane-fill text-primary"></i> Lisbon Airport (LIS)</span>
                                            <a href="/Lockers?location=PT-LIS" class="btn btn-sm" style="min-width: 100px; background-color: #0d6efd; color: white; border: none;">View Lockers</a>
                                        </li>
                                        <li class="list-group-item d-flex justify-content-between align-items-center">
                                            <span><i class="bi bi-train-front-fill text-primary"></i> Coimbra Train Station (CPB)</span>
                                            <a href="/Lockers?location=PT-CPB" class="btn btn-sm" style="min-width: 100px; background-color: #0d6efd; color: white; border: none;">View Lockers</a>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </div>

                        <!-- Spain -->
                        <div class="col-md-6 mb-4">
                            <div class="card h-100 border-success">
                                <div class="card-header bg-success text-white">
                                    <h5 class="mb-0">
                                        <span class="fi fi-es" style="font-size: 1.5rem; margin-right: 8px;"></span>Spain
                                    </h5>
                                </div>
                                <div class="card-body">
                                    <ul class="list-group list-group-flush">
                                        <li class="list-group-item d-flex justify-content-between align-items-center">
                                            <span><i class="bi bi-airplane-fill text-success"></i> Barcelona Airport (BCN)</span>
                                            <a href="/Lockers?location=ES-BCN" class="btn btn-sm" style="min-width: 100px; background-color: #198754; color: white; border: none;">View Lockers</a>
                                        </li>
                                        <li class="list-group-item d-flex justify-content-between align-items-center">
                                            <span><i class="bi bi-airplane-fill text-success"></i> Madrid Airport (MAD)</span>
                                            <a href="/Lockers?location=ES-MAD" class="btn btn-sm" style="min-width: 100px; background-color: #198754; color: white; border: none;">View Lockers</a>
                                        </li>
                                        <li class="list-group-item d-flex justify-content-between align-items-center">
                                            <span><i class="bi bi-train-front-fill text-success"></i> Santiago Train Station (SCQ)</span>
                                            <a href="/Lockers?location=ES-SCQ" class="btn btn-sm" style="min-width: 100px; background-color: #198754; color: white; border: none;">View Lockers</a>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>