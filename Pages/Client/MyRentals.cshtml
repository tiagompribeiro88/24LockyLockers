@page
@model _24LockyLockers.Pages.Client.MyRentalsModel
@{
    ViewData["Title"] = "My Rentals";
}

<div class="container">
    <div class="page-header">
        <h1>My Rentals</h1>
    </div>

    <div class="row mb-4">
        <div class="col-12">
            <a asp-page="/Client/Index" class="btn btn-outline-light">
                <i class="bi bi-arrow-left"></i> Back to Dashboard
            </a>
        </div>
    </div>

    @if (TempData["Success"] is string successMessage)
    {
        <div class="alert alert-success">
            <i class="bi bi-check-circle-fill"></i> @successMessage
        </div>
    }

    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    @if (Model.ActiveRentals.Any())
                    {
                        <h4 class="card-title text-success mb-3">
                            <i class="bi bi-clock-history"></i> Active Rentals
                        </h4>
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Locker</th>
                                        <th>Location</th>
                                        <th>Start Time</th>
                                        <th>Access Code</th>
                                        <th>Price</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var rental in Model.ActiveRentals)
                                    {
                                        <tr>
                                            <td><strong>@rental.Locker?.LockerNumber</strong></td>
                                            <td>@rental.Locker?.Location?.LocationName</td>
                                            <td>@rental.StartTime.ToString("yyyy-MM-dd HH:mm")</td>
                                            <td>
                                                <span class="badge bg-success">@rental.AccessCode</span>
                                            </td>
                                            <td>€@rental.Price.ToString("F2")</td>
                                            <td>
                                                <form method="post" asp-page-handler="EndRental" asp-route-rentalId="@rental.Id" style="display:inline;">
                                                    <button type="submit" class="btn btn-sm btn-danger"
                                                            onclick="return confirm('End this rental?')">
                                                        <i class="bi bi-stop-circle"></i> End Rental
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info">
                            <i class="bi bi-info-circle-fill"></i> No active rentals.
                        </div>
                    }

                    <hr class="my-4" />

                    @if (Model.PastRentals.Any())
                    {
                        <h4 class="card-title text-muted mb-3">
                            <i class="bi bi-archive"></i> Past Rentals
                        </h4>
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Locker</th>
                                        <th>Location</th>
                                        <th>Start Time</th>
                                        <th>End Time</th>
                                        <th>Price</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var rental in Model.PastRentals)
                                    {
                                        <tr>
                                            <td>@rental.Locker?.LockerNumber</td>
                                            <td>@rental.Locker?.Location?.LocationName</td>
                                            <td>@rental.StartTime.ToString("yyyy-MM-dd HH:mm")</td>
                                            <td>@(rental.EndTime?.ToString("yyyy-MM-dd HH:mm") ?? "N/A")</td>
                                            <td>€@rental.Price.ToString("F2")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info">
                            <i class="bi bi-info-circle-fill"></i> No past rentals.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>