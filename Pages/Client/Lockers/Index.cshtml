@page
@model _24LockyLockers.Pages.Client.Lockers.IndexModel
@{
    ViewData["Title"] = "Lockers - " + Model.Location;
}

<div class="container">
    <div class="page-header">
        <h1><i class="bi bi-lock-fill"></i> Lockers at @Model.Location</h1>
        <p class="text-white-50">Available lockers for rent</p>
    </div>

    <div class="row mb-4">
        <div class="col-12">
            <a asp-page="/Client/Index" class="btn btn-outline-light">
                <i class="bi bi-arrow-left"></i> Back to Locations
            </a>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    @if (Model.Lockers.Any())
                    {
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Locker Number</th>
                                    <th>Status</th>
                                    <th>Last Used</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var locker in Model.Lockers)
                                {
                                    <tr>
                                        <td><strong>@locker.LockerNumber</strong></td>
                                        <td>
                                            @if (locker.IsAvailable)
                                            {
                                                <span class="badge bg-success">Available</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger">Occupied</span>
                                            }
                                        </td>
                                        <td>@(locker.LastUsed?.ToString("yyyy-MM-dd HH:mm") ?? "Never")</td>
                                        <td>
                                            @if (locker.IsAvailable)
                                            {
                                                <button class="btn btn-sm btn-primary">
                                                    <i class="bi bi-key-fill"></i> Rent
                                                </button>
                                            }
                                            else
                                            {
                                                <button class="btn btn-sm btn-secondary" disabled>
                                                    <i class="bi bi-lock-fill"></i> Occupied
                                                </button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <div class="alert alert-info">
                            <i class="bi bi-info-circle-fill"></i> No lockers found for this location.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>