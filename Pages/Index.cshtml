@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<div class="container">
    <div class="page-header">
        <h1>Welcome to 24LockyLockers</h1>
        <p class="text-white-50">Secure locker rentals at airports and train stations across Portugal and Spain</p>
    </div>

<div class="row mt-5">
        <!-- Portugal - Porto Airport -->
        <div class="col-12 col-md-6 mb-4 location-pt-opo">
            <div class="card h-100 border-primary">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">
                        <span class="fi fi-pt" style="font-size: 1.5rem; margin-right: 8px;"></span>Select a location in Portugal
                    </h5>
                </div>
                <div class="card-body">
                    <div class="location-link">
                        <a href="/Lockers?location=PT-OPO">
                            <i class="bi bi-airplane-fill text-primary"></i> Porto Airport (OPO)
                        </a>
                    </div>
                    <div class="location-link">
                        <a href="/Lockers?location=PT-LIS">
                            <i class="bi bi-airplane-fill text-primary"></i> Lisbon Airport (LIS)
                        </a>
                    </div>
                    <div class="location-link">
                        <a href="/Lockers?location=PT-CPB">
                            <i class="bi bi-train-front-fill text-primary"></i> Coimbra Train Station (CPB)
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Spain - Barcelona Airport -->
        <div class="col-12 col-md-6 mb-4 location-es-bcn">
            <div class="card h-100 border-success">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">
                        <span class="fi fi-es" style="font-size: 1.5rem; margin-right: 8px;"></span>Select a location in Spain
                    </h5>
                </div>
                <div class="card-body">
                    <div class="location-link">
                        <a href="/Lockers?location=ES-BCN">
                            <i class="bi bi-airplane-fill text-success"></i> Barcelona Airport (BCN)
                        </a>
                    </div>
                    <div class="location-link">
                        <a href="/Lockers?location=ES-MAD">
                            <i class="bi bi-airplane-fill text-success"></i> Madrid Airport (MAD)
                        </a>
                    </div>
                    <div class="location-link">
                        <a href="/Lockers?location=ES-SCQ">
                            <i class="bi bi-train-front-fill text-success"></i> Santiago Train Station (SCQ)
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="text-center mt-4">
    <a asp-page="/About" class="btn btn-outline-primary btn-lg">
        <i class="bi bi-info-circle"></i> About This Project
    </a>
    <a asp-page="/Account/Login" class="btn btn-primary btn-lg ms-2">
        <i class="bi bi-box-arrow-in-right"></i> Login
    </a>
</div>